{
  "name": "skillshadow",
  "version": "0.1.2",
  "description": "Find out which of your Claude Code skills and slash commands are shadowed by built-ins, aliases, reserved names or higher scopes.",
  "license": "MIT",
  "type": "module",
  "bin": { "skillshadow": "dist/cli.js" },
  "engines": { "node": ">=22" },
  "files": ["dist/", "builtins/", "fixtures/demo/", "README.md", "README.ko.md", "CHANGELOG.md", "LICENSE"],
  "keywords": ["claude-code", "skills", "slash-commands", "cli", "lint"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build && tsc -p tsconfig.test.json",
    "test": "node --test --test-reporter=spec \"dist-test/test/*.test.js\"",
    "prestart": "npm run build",
    "start": "node dist/cli.js check --demo --fail-on none"
  },
  "devDependencies": {
    "@types/node": "26.6.11",
    "typescript": "7.0.2"
  }
}
